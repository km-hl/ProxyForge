[Unit]
Description=ProxyForge managed go-gost data plane (independent instance)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/proxyforge-runtime/services/gost/current/config.json
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=proxyforge-gost
Group=proxyforge-gost
ExecStart=/var/lib/proxyforge-runtime/services/gost/current/gost -C /var/lib/proxyforge-runtime/services/gost/current/config.json
WorkingDirectory=/var/lib/proxyforge-runtime/services/gost
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/proxyforge-runtime/services/gost/state
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Environment=GOMEMLIMIT=64MiB
Environment=GOGC=50
Environment=GOMAXPROCS=2

[Install]
WantedBy=multi-user.target
