[Unit]
Description=ProxyForge managed Caddy (independent instance)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/proxyforge-runtime/services/caddy/current/Caddyfile
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=proxyforge-caddy
Group=proxyforge-caddy
ExecStart=/var/lib/proxyforge-runtime/services/caddy/current/caddy run --config /var/lib/proxyforge-runtime/services/caddy/current/Caddyfile --adapter caddyfile
WorkingDirectory=/var/lib/proxyforge-runtime/services/caddy
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/proxyforge-runtime/services/caddy/state
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
Environment=GOMEMLIMIT=32MiB
Environment=GOGC=50
Environment=GOMAXPROCS=1

[Install]
WantedBy=multi-user.target
